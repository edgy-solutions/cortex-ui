{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "node" added 2026-08-22: `types` is an ALLOWLIST, so naming vite/client alone
    // excluded @types/node even once installed. src/dependencyLicense.guard.test.ts reads
    // package.json and the lockfile through node:fs, and `npm run build` runs tsc — so
    // without this the licence guard type-errors the build it exists to protect.
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* React JSX */
    "jsx": "react-jsx",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
