# ── Frontend Environment ──────────────────────────────────
# This file is read by Vite. ONLY VITE_* vars are bundled into client JS.
# NEVER put secrets or internal service URLs here.
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_REALM_URL=http://localhost:8080/realms/cortex
VITE_KEYCLOAK_CLIENT_ID=cortex-ui
VITE_NO_AUTH=false
VITE_ELECTRIC_URL=http://localhost:3000
VITE_FEATURES=
VITE_MOCK_GROUNDING=
# Send frontend_version on /interview/stream. Only the exact value "true" enables it; default OFF.
# The platform discards the field until InterviewRequest declares it — leave off until then.
VITE_SEND_FRONTEND_VERSION=
# Grouped-review ONLY: row edits (delete/add/correct an MPN) and the Reject control. Default ON: only the exact lowercase value "false" turns them off.
# The live platform (49aa5e28) accepts row_edits + reason_code on HumanTaskActRequest — Lane 1 packet sessions/2026-10-12-packet-to-cortex-f3617a9-is-live-notice-id-named-row-edits-accepted-flip-it.md.
VITE_REVIEW_ROW_EDITS=
# Promotion card row editor + title-line header editor. OFF unless the value is exactly lowercase "true".
# Server half is IAGENT_PROMOTION_ROW_EDITS (ON only for "true", set only in the sandbox) — sandbox only until the TYC proof.
VITE_PROMOTION_ROW_EDITS=
