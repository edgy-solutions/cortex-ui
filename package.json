{
  "name": "cortex-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "check:transport": "node scripts/check-transport-declarations.mjs",
    "check:transport:redproof": "node scripts/redproof-transport-guard.mjs",
    "build": "npm run check:transport && npm run test && tsc && vite build",
    "start": "serve dist -s -l ${PORT:-8080}",
