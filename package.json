    "@xyflow/react": "^12.10.0",
    "axios": "^1.13.5",
    "framer-motion": "^12.34.2",
    "lucide-react": "^0.574.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.4",
